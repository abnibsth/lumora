# Copy to .env and adjust. The app falls back to these values if .env is missing.
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://lumora:lumora@localhost:5432/lumora?sslmode=disable
UPLOAD_DIR=uploads
# Draft generator for POST /api/v1/ai/draft-profile.
#   gemini = provider asli (default). Butuh GEMINI_API_KEY, kalau kosong app
#            menolak start supaya tidak diam-diam menjawab 503.
#   stub   = heuristik offline, tanpa jaringan dan tanpa API key. Pakai ini
#            kalau mau menjalankan tanpa kredensial.
AI_PROVIDER=gemini
# Ambil dari https://aistudio.google.com/apikey. Jangan commit nilai aslinya.
GEMINI_API_KEY=
# Opsional. Kosong berarti pakai default di kode (gemini-3.1-flash-lite).
# Ganti kalau model default sudah di-retire Google (lihat docs/api.md).
GEMINI_MODEL=
# Kuota draf AI per akun per jam. Tiap draf memanggil provider berbayar, jadi
# endpoint-nya dibatasi per akun (bukan per IP). Harus bilangan bulat positif;
# nilai tidak valid ditolak saat start, bukan dibaca sebagai "tanpa batas".
# Setel besar (mis. 1000) kalau sedang mengembangkan tanpa mau kena 429.
AI_DRAFT_LIMIT_PER_HOUR=20
