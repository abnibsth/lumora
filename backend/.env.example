# Copy to .env and adjust. The app falls back to these values if .env is missing.
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://lumora:lumora@localhost:5432/lumora?sslmode=disable
UPLOAD_DIR=uploads
# Draft generator for POST /api/v1/ai/draft-profile. "stub" is the only value
# today: it runs offline, needs no API key, and never invents revenue figures.
AI_PROVIDER=stub
