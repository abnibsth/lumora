# ============================================================
#  Konfigurasi produksi LUMORA (VPS)
#  Cara pakai:
#    1. cp .env.production.example .env.production
#    2. isi semua nilai yang bertanda <...> di bawah
#    3. jangan commit .env.production (sudah di .gitignore)
# ============================================================

# ---------- Database (Postgres di dalam compose) ----------
POSTGRES_USER=lumora
# GANTI dengan password acak yang kuat, mis. hasil `openssl rand -hex 16`
POSTGRES_PASSWORD=<GANTI_password_kuat_acak>
POSTGRES_DB=lumora

# ---------- AI draf profil (backend) ----------
# Frontend sudah memakai provider Atria sendiri (CHAT_AI_*) untuk draf AI & chat,
# jadi backend tidak wajib pakai Gemini. "stub" = offline, tanpa key, aman di
# production. Kalau mau backend pakai Gemini asli, ganti ke "gemini" + isi key.
AI_PROVIDER=stub
GEMINI_API_KEY=
# Kosong = pakai default di kode (gemini-3.1-flash-lite). Isi hanya kalau
# AI_PROVIDER=gemini dan model default sudah di-retire Google.
GEMINI_MODEL=

# ---------- Email verifikasi (WAJIB resend di production) ----------
EMAIL_PROVIDER=resend
RESEND_API_KEY=<tempel_key_resend_di_sini>
# Kosong = onboarding@resend.dev -> Resend HANYA bisa kirim ke email pemilik
# akun Resend. Untuk kirim ke publik, verifikasi domain di Resend lalu isi,
# mis. no-reply@lumora.id
RESEND_FROM=

# ---------- URL frontend Vercel (dipakai untuk link verifikasi email) ----------
FRONTEND_BASE_URL=https://<nama-proyek>.vercel.app
